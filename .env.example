# ==============================================================================
# Golden Hour — Local Development Environment Configuration
# Copy this file to .env before starting services with Docker Compose:
#   cp .env.example .env
# ==============================================================================

# ── Application Environment ──────────────────────────────────────────────────
ENVIRONMENT=development
APP_ENV=development
PORT=8000
API_PUBLIC_BASE_URL=http://localhost:8000
APP_BASE_URL=http://localhost:3000

# ── Security & JWT Cryptography ──────────────────────────────────────────────
# Generate secure keys in production via: openssl rand -hex 32
SECRET_KEY=change-me-to-a-secure-random-32-byte-hex-string-for-production
JWT_SECRET_KEY=change-me-to-a-secure-random-32-byte-hex-string-for-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

# ── Database (PostgreSQL 15) ─────────────────────────────────────────────────
POSTGRES_USER=goldenhour
POSTGRES_PASSWORD=goldenhour_dev_secret_password
POSTGRES_DB=goldenhour
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://goldenhour:goldenhour_dev_secret_password@db:5432/goldenhour

# ── Cache & Session Broker (Redis 7) ─────────────────────────────────────────
REDIS_URL=redis://redis:6379/0

# ── Document & Media Storage ─────────────────────────────────────────────────
STORAGE_BACKEND=local
UPLOAD_DIR=/app/uploads

# ── WhatsApp Cloud API (Optional for dev / stubbed) ──────────────────────────
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_TEMPLATE_NAME=

# ── Firebase Cloud Messaging & Service Account ───────────────────────────────
FIREBASE_CREDENTIALS_JSON=./firebase-service-account.json

# ── Email Service (Resend) ───────────────────────────────────────────────────
RESEND_API_KEY=
FROM_EMAIL=alerts@goldenhr.in

# ── Monitoring & Sentry Error Tracking ───────────────────────────────────────
SENTRY_DSN=

# ── Analytics (Google Analytics Measurement Protocol) ────────────────────────
GA_MEASUREMENT_ID=
GA_API_SECRET=

# ── Rate Limiting & Dedup Policies ───────────────────────────────────────────
MAX_SCANS_PER_QR_PER_HOUR=20
NOTIFICATION_DEDUP_MINUTES=5

# ── Admin Web Frontend (Vite) ────────────────────────────────────────────────
VITE_API_URL=http://localhost:8000/api/v1

